DATABASE_URL="postgresql://tutorias:tutorias@localhost:5432/tutorias_dev?schema=public"
PORT=4002

# Identity-service: emite los JWT (RS256) y responde la introspección de sesión.
IDENTITY_SERVICE_URL="http://localhost:4001"
JWT_ISSUER="uets-dece-identity"
JWT_AUDIENCE="uets-dece"
# Cuánto se cachea la validación de una sesión (ms). Tras un logout/desactivación, el token
# puede seguir aceptándose como máximo este tiempo.
IDENTITY_SESSION_CACHE_TTL_MS=30000

# Entrega de eventos (correos) al notification-service
NOTIFICATION_SERVICE_URL="http://localhost:4003"
INTERNAL_SERVICE_TOKEN=""
# Desfase horario de la institución respecto a UTC (Ecuador: -300)
SCHOOL_UTC_OFFSET_MINUTES=-300
