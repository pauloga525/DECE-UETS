# notification-service
DATABASE_URL="postgresql://tutorias:tutorias@localhost:5432/tutorias_dev?schema=notifications"
PORT=4003
IDENTITY_SERVICE_URL="http://localhost:4001"
INTERNAL_SERVICE_TOKEN="genera-un-secreto-largo-compartido"
PORTAL_URL="http://localhost:3100"

# Solo aplica con NODE_ENV=production. En desarrollo SIEMPRE es "log" (no envía; guarda .eml en mail-outbox/).
# send = envío real · redirect = envía todo a MAIL_REDIRECT_TO
MAIL_MODE=log
MAIL_REDIRECT_TO=

# ---------- Correo (cuenta noreply; solo envío, sin Reply-To) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=noreply@uets.edu.ec
SMTP_PASS="xxxx xxxx xxxx xxxx"
MAIL_FROM="Sistema DECE UETS <noreply@uets.edu.ec>"
