# Base propia del servicio: schema "identity" (database-per-service; en desarrollo comparte
# la instancia de Postgres con tutoring-service pero no sus tablas).
DATABASE_URL="postgresql://tutorias:tutorias@localhost:5432/tutorias_dev?schema=identity"
PORT=4001

# Client ID OAuth 2.0 (tipo "Aplicación web") de Google Cloud — ver docs/guia-google-oauth.md
GOOGLE_CLIENT_ID=""

# Política de correos: solo este dominio exacto; se rechazan las partes locales con estos sufijos
ALLOWED_EMAIL_DOMAIN="uets.edu.ec"
BLOCKED_EMAIL_LOCAL_SUFFIXES=".est"

# JWT RS256. En desarrollo, si está vacío, se genera una clave en .keys/ automáticamente.
# En producción es OBLIGATORIA (PEM PKCS#8; los saltos de línea pueden ir como \n).
JWT_PRIVATE_KEY=""
JWT_EXPIRES_IN="8h"
JWT_ISSUER="uets-dece-identity"
JWT_AUDIENCE="uets-dece"

# Login solo con correo (sin Google) para desarrollo local. Ignorado si NODE_ENV=production.
DEV_LOGIN_ENABLED="true"

# Opcional: tu correo institucional real, creado como ADMIN por "npm run seed".
SEED_ADMIN_EMAIL=""

# Llamadas servicio-a-servicio (mismo valor en identity, tutoring y notification)
INTERNAL_SERVICE_TOKEN=""
