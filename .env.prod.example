# Variables para docker-compose.prod.yml — copiar a ".env" en la raíz del repo
# (docker compose lo lee automáticamente) y completar con valores reales.
# NUNCA commitear el ".env" real — ya está en .gitignore.

# --- Postgres: rol dueño de las migraciones ---
DB_OWNER_USER=tutorias
DB_OWNER_PASSWORD=cambia-esto-por-un-secreto-fuerte
DB_NAME=tutorias_prod

# --- identity-service: su propio schema "identity" (usa el rol dueño; aplica sus migraciones al arrancar) ---
IDENTITY_DATABASE_URL=postgresql://tutorias:cambia-esto-por-un-secreto-fuerte@postgres:5432/tutorias_prod?schema=identity

# Client ID OAuth "Aplicación web" de Google Cloud — ver docs/guia-google-oauth.md
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
ALLOWED_EMAIL_DOMAIN=uets.edu.ec
BLOCKED_EMAIL_LOCAL_SUFFIXES=.est

# Clave privada RSA para firmar los JWT (PEM PKCS#8 en UNA línea, saltos como \n). Generar con:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | awk '{printf "%s\\n", $0}'
JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
JWT_EXPIRES_IN=8h

# --- tutoring-service en runtime: rol restringido tutorias_app (regla 15 — insert-only en audit_logs) ---
# La migración audit_log_insert_only lo crea con password 'change-me-in-production'.
# Cambiala en el primer despliegue (ver guía) y reflejá el valor nuevo aquí.
TUTORING_DATABASE_URL=postgresql://tutorias_app:change-me-in-production@postgres:5432/tutorias_prod?schema=public

# --- URL pública del portal (CORS del gateway y enlaces de los correos) ---
# Red local con nip.io (ver docs/guia-despliegue.md, sección 3.5): https://dece.192-168-200-31.nip.io
# Debe estar también en "Orígenes de JavaScript autorizados" del Client ID de Google.
PUBLIC_URL=https://dece.192-168-200-31.nip.io

# --- Puertos del host (todos solo en 127.0.0.1); cambiarlos si el servidor ya los usa ---
PORTAL_PORT=3001
GATEWAY_PORT=4000
DB_PORT=5432

# --- Llamadas servicio-a-servicio (identity, tutoring, notification comparten este secreto) ---
# Generar con: openssl rand -hex 24
INTERNAL_SERVICE_TOKEN=genera-un-secreto-largo-aqui

# --- notification-service: su propio schema; SOLO envía correos, nunca los recibe ---
NOTIFICATION_DATABASE_URL=postgresql://tutorias:cambia-esto-por-un-secreto-fuerte@postgres:5432/tutorias_prod?schema=notifications
# send = envío real · log = no envía (guarda .eml) · redirect = todo a MAIL_REDIRECT_TO (pruebas)
# Primer despliegue: redirect, para que ningún correo llegue a representantes reales mientras se prueba.
MAIL_MODE=redirect
MAIL_REDIRECT_TO=pauloga@uets.edu.ec
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=noreply@uets.edu.ec
# "Contraseña de aplicación" de Google de la cuenta noreply (no la contraseña de la cuenta)
SMTP_PASS=xxxx xxxx xxxx xxxx
# Sin Reply-To: representantes y docentes no pueden responder a estos correos.
MAIL_FROM=Sistema DECE UETS <noreply@uets.edu.ec>
